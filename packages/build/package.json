{
  "name": "@engine/build",
  "version": "0.1.0",
  "description": "Production build (bundle, minify, content-hashed files, manifest, precompression) and a dev server with live manifest and page reload",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "engine-build": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "API.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game-engine",
    "javascript",
    "webgpu",
    "multiplayer",
    "build"
  ]
}
