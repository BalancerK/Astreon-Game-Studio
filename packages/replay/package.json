{
  "name": "@engine/replay",
  "version": "0.1.0",
  "description": "Replays and spectating: record a match as compact snapshot deltas (seek anywhere, any speed) or as its inputs (a few KB, with drift detection), a delayed feed shared by any number of spectators",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "API.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game-engine",
    "javascript",
    "webgpu",
    "multiplayer",
    "replay"
  ],
  "dependencies": {
    "@engine/protocol": "^0.1.0"
  }
}
