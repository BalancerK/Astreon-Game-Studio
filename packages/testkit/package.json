{
  "name": "@engine/testkit",
  "version": "0.1.0",
  "description": "Test a game in a real browser from a script: drive headless Chrome, time frames, check the built pages; never leaves a browser running",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "API.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game-engine",
    "javascript",
    "webgpu",
    "multiplayer",
    "testkit"
  ],
  "dependencies": {
    "@engine/build": "^0.1.0"
  }
}
