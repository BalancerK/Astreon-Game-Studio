{
  "name": "@engine/turns",
  "version": "0.1.0",
  "description": "Turn-based and card games: rules as plain functions with hidden information and seeded randomness, a server room (tokens, robots, turn timers, rematch) and a client with reconnect",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "API.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game-engine",
    "javascript",
    "webgpu",
    "multiplayer",
    "turns"
  ],
  "dependencies": {
    "@engine/matchmaking": "^0.1.0",
    "@engine/transport": "^0.1.0"
  }
}
